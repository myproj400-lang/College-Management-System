generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REGISTRAR
  BURSAR
  LECTURER
  STUDENT
  APPLICANT
  ADMISSIONS_OFFICER
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student          Student?
  staff            Staff?
  paymentsRecorded Payment[]
  auditLogs        AuditLog[]
  announcements    Announcement[]

  applications            Application[]              @relation("Applicant")
  assignedApplications    Application[]              @relation("AssignedOfficer")
  applicationDecisions    ApplicationDecision[]      @relation("DecisionActor")
  paymentEventsRecorded   ApplicationPaymentEvent[]  @relation("PaymentActor")
  deadlineExtensions      DeadlineExtension[]        @relation("ExtensionActor")
  contactVerification     ContactVerification?
}

/// A semester in the academic calendar. Enrollments, timetables and fee
/// invoices refer to a term by its academicYear + semester pair.
model AcademicTerm {
  id                   String    @id @default(cuid())
  academicYear         String // e.g. "2026/2027"
  semester             Int
  startDate            DateTime  @db.Date
  endDate              DateTime  @db.Date
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  maxCredits           Int       @default(24)
  isCurrent            Boolean   @default(false)
  resultsPublishedAt   DateTime?
  createdAt            DateTime  @default(now())

  @@unique([academicYear, semester])
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  programmes Programme[]
  courses    Course[]
  staff      Staff[]
}

model Programme {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  level         String // e.g. Certificate, Diploma, Bachelor's
  durationYears Int
  departmentId  String
  createdAt     DateTime @default(now())

  department   Department    @relation(fields: [departmentId], references: [id])
  students     Student[]
  courses      Course[]
  intakes      Intake[]
  applications Application[]
}

model Course {
  id               String   @id @default(cuid())
  code             String   @unique
  title            String
  creditHours      Int
  semester         Int // 1 or 2 — the semester the course is normally offered
  departmentId     String
  programmeId      String?
  lecturerId       String?
  /// Percentage of the final score that comes from coursework; the rest is the exam.
  courseworkWeight Int      @default(40)
  createdAt        DateTime @default(now())

  department    Department           @relation(fields: [departmentId], references: [id])
  programme     Programme?           @relation(fields: [programmeId], references: [id])
  lecturer      Staff?               @relation(fields: [lecturerId], references: [id])
  enrollments   Enrollment[]
  prerequisites CoursePrerequisite[] @relation("CourseRequires")
  requiredBy    CoursePrerequisite[] @relation("PrerequisiteFor")
  classSessions ClassSession[]
}

model CoursePrerequisite {
  courseId       String
  prerequisiteId String

  course       Course @relation("CourseRequires", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("PrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([courseId, prerequisiteId])
}

/// A weekly timetable slot for a course in a given term.
model ClassSession {
  id           String   @id @default(cuid())
  courseId     String
  academicYear String
  semester     Int
  dayOfWeek    Int // 1 = Monday … 7 = Sunday
  startTime    String // "HH:MM", 24-hour
  endTime      String
  room         String
  createdAt    DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([academicYear, semester, dayOfWeek])
}

model Student {
  id            String        @id @default(cuid())
  userId        String        @unique
  studentNumber String        @unique
  programmeId   String
  yearOfStudy   Int           @default(1)
  status        StudentStatus @default(ACTIVE)
  admissionDate DateTime      @default(now())
  dateOfBirth   DateTime?
  phone         String?
  address       String?

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme         Programme    @relation(fields: [programmeId], references: [id])
  enrollments       Enrollment[]
  invoices          FeeInvoice[]
  sourceApplication Application?
}

model Staff {
  id           String  @id @default(cuid())
  userId       String  @unique
  staffNumber  String  @unique
  position     String
  departmentId String?
  phone        String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  courses    Course[]
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  courseId        String
  academicYear    String // e.g. "2026/2027"
  semester        Int
  status          EnrollmentStatus @default(ENROLLED)
  courseworkScore Float?
  examScore       Float?
  score           Float?
  grade           String?
  gradePoint      Float?
  createdAt       DateTime         @default(now())

  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course             @relation(fields: [courseId], references: [id])
  attendance AttendanceRecord[]

  @@unique([studentId, courseId, academicYear, semester])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  enrollmentId String
  date         DateTime         @db.Date
  status       AttendanceStatus

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
}

model FeeInvoice {
  id           String   @id @default(cuid())
  studentId    String
  academicYear String
  description  String
  amount       Decimal  @db.Decimal(12, 2)
  dueDate      DateTime
  createdAt    DateTime @default(now())

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id           String        @id @default(cuid())
  receiptNo    Int           @unique @default(autoincrement())
  invoiceId    String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String

  invoice    FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User       @relation(fields: [recordedById], references: [id])
}

/// Notice shown to signed-in users. A null audience or programme means "everyone".
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    Role?
  programmeId String?
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([publishedAt])
}

/// Append-only record of sensitive changes: who did what, to which record, when.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // e.g. "grade.update", "payment.create"
  entity    String // e.g. "Enrollment"
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Online admissions. User remains the account until a separate Person model
/// is agreed with the identity work. See docs/decision-log.md DL-14.

enum ApplicationState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUESTED
  OFFERED
  WAITLISTED
  REJECTED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  WITHDRAWN
}

enum DocumentState {
  INITIATED
  UPLOADED
  SCANNING
  AVAILABLE
  REJECTED
}

enum ApplicationFeeStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  FAILED
  WAIVED
  REFUNDED
}

enum DecisionKind {
  RECOMMENDATION
  FINAL
  REOPEN
}

enum DecisionOutcome {
  OFFERED
  WAITLISTED
  REJECTED
  REOPENED
}

model Intake {
  id                     String   @id @default(cuid())
  programmeId            String
  name                   String
  opensAt                DateTime
  closesAt               DateTime
  /// IANA timezone name supplied by staff. The college timezone is still an open decision.
  timezone               String
  entryRequirements      String
  feeInstructions        String
  feeRequired            Boolean
  reviewBeforePayment    Boolean  @default(false)
  feeAmount              Decimal? @db.Decimal(12, 2)
  currency               String?
  requiredDocuments      Json
  declarations           Json
  maxDocumentBytes       Int
  allowedContentTypes    Json
  secondApprovalRequired Boolean  @default(false)
  ruleVersion            Int      @default(1)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  programme    Programme           @relation(fields: [programmeId], references: [id])
  applications Application[]
  extensions   DeadlineExtension[]
}

model Application {
  id                   String               @id @default(cuid())
  applicantId          String
  programmeId          String
  intakeId             String
  state                ApplicationState     @default(DRAFT)
  revision             Int                  @default(1)
  reference            String?              @unique
  paymentReference     String               @unique
  submittedAt          DateTime?
  ruleVersion          Int?
  draft                Json
  requiredDocuments    Json?
  feeStatus            ApplicationFeeStatus @default(PENDING)
  feeAmountSnapshot    Decimal?             @db.Decimal(12, 2)
  currencySnapshot     String?
  feeRequiredSnapshot  Boolean              @default(false)
  reviewBeforePayment  Boolean              @default(false)
  assignmentRevision   Int                  @default(0)
  assignedOfficerId    String?
  offerDeadline        DateTime?
  offerConditions      String?
  correctionFields     Json?
  correctionDeadline   DateTime?
  correctionMessage    String?
  convertedStudentId   String?              @unique
  requirementsMet      Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  applicant        User                      @relation("Applicant", fields: [applicantId], references: [id])
  assignedOfficer  User?                     @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  programme        Programme                 @relation(fields: [programmeId], references: [id])
  intake           Intake                    @relation(fields: [intakeId], references: [id])
  convertedStudent Student?                  @relation(fields: [convertedStudentId], references: [id])
  snapshots        ApplicationSnapshot[]
  documents        ApplicationDocument[]
  decisions        ApplicationDecision[]
  payments         ApplicationPaymentEvent[]
  extensions       DeadlineExtension[]

  @@index([applicantId])
  @@index([state, intakeId])
}

model ApplicationSnapshot {
  id            String   @id @default(cuid())
  applicationId String
  revision      Int
  payload       Json
  ruleVersion   Int
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, revision])
}

model ApplicationDocument {
  id              String        @id @default(cuid())
  applicationId   String
  requirementCode String
  fileName        String
  contentType     String
  byteSize        Int
  storageKey      String        @unique
  state           DocumentState
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, requirementCode])
}

model ApplicationDecision {
  id           String          @id @default(cuid())
  applicationId String
  kind         DecisionKind
  outcome      DecisionOutcome
  reason       String
  internalNote String?
  actorId      String
  createdAt    DateTime        @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  actor       User        @relation("DecisionActor", fields: [actorId], references: [id])
}

model ApplicationPaymentEvent {
  id            String               @id @default(cuid())
  applicationId String
  providerId    String
  eventId       String
  reference     String
  amount        Decimal              @db.Decimal(12, 2)
  currency      String
  state         ApplicationFeeStatus
  reason        String?
  actorId       String
  createdAt     DateTime             @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  actor       User        @relation("PaymentActor", fields: [actorId], references: [id])

  @@unique([providerId, eventId])
}

model DeadlineExtension {
  id            String   @id @default(cuid())
  intakeId      String
  applicationId String
  reason        String
  expiresAt     DateTime
  actorId       String
  createdAt     DateTime @default(now())

  intake      Intake      @relation(fields: [intakeId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  actor       User        @relation("ExtensionActor", fields: [actorId], references: [id])
}

model SubmissionIdempotency {
  id            String   @id @default(cuid())
  userId        String
  key           String
  requestHash   String
  applicationId String
  statusCode    Int
  response      Json
  createdAt     DateTime @default(now())

  @@unique([userId, key])
}

model ReferenceCounter {
  name String @id
  next Int
}

model ContactVerification {
  id             String    @id @default(cuid())
  userId         String    @unique
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  /// UNDELIVERED until an email provider exists. CAPTURED is the test double only.
  deliveryStatus String
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}
