# Copy to .env and fill in real values for your environment.
# Never commit a real .env file. All values here are placeholders.

NODE_ENV=development
PORT=4000

# Postgres connection string. In local/test environments without a full
# PostgreSQL install, run `npm run db:dev` in a separate terminal (an
# embedded Postgres-compatible engine - PGlite - served over the real
# wire protocol) and point this at it. `sslmode=disable` is REQUIRED
# against PGlite: its wire-protocol server has no SSL negotiation support
# and resets the connection if a client sends an SSLRequest packet, which
# Prisma's client sends by default unless this is set explicitly.
# `connection_limit=1` is also required: PGlite's embedded engine only
# tolerates one connection at a time and does not queue a second one.
# `pgbouncer=true` is also required: PGlite exposes one underlying session
# across separate TCP connections rather than a fresh session per
# connection, so Prisma's normal named prepared statements (s0, s1, ...)
# collide across separate process runs ("prepared statement already
# exists"). This flag tells Prisma to use unnamed statements instead, the
# same accommodation real deployments make for transaction-mode PgBouncer.
# In staging/production, point this at a real managed PostgreSQL instance
# and drop all three of these - a real server supports SSL, many
# connections, and per-connection session isolation.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public&sslmode=disable&pgbouncer=true&connection_limit=1"

# Random 32+ byte secret used to sign the session cookie value (defense in
# depth on top of server-side session lookup/revocation). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=replace-with-a-random-64-char-hex-string

# Session lifetime policy (SRS-006). Placeholder values pending security-owner approval.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Single-use recovery/verification token lifetime (SRS-004).
RECOVERY_TOKEN_TTL_MINUTES=30

# Issuer name shown in authenticator apps for privileged-role MFA enrollment.
MFA_ISSUER=ICMS

# Roles that require MFA before a session is treated as fully authenticated (SEC-01).
# Comma-separated RoleGrant role values.
MFA_REQUIRED_ROLES=SYSTEM_ADMINISTRATOR,REGISTRY_PUBLISHER,FINANCE_VERIFIER

# Seed script: local/dev-only bootstrap administrator password.
# Never set this in a real environment; the seed script refuses to run
# against a database whose NODE_ENV is "production".
SEED_ADMIN_PASSWORD=
