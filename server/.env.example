# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# For local development without installing PostgreSQL, run `npm run db:local`
# (a real PostgreSQL on port 5433, no install needed) and use the URL below.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

PORT=4000

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"

# Applicant contact verification. Leave as undelivered until an email provider
# is approved. Do not set capture outside automated tests.
CONTACT_CHANNEL="undelivered"
# Proposed verification lifetime in hours. Not a signed college policy.
CONTACT_VERIFICATION_TTL_HOURS="24"

# Initial admin account created by `npm run seed`.
SEED_ADMIN_EMAIL="admin@college.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
