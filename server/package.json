{
  "name": "icms-server",
  "version": "0.1.0",
  "private": true,
  "description": "Integrated College Management System - backend (Phase B0: Foundation & Identity)",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:test": "cross-env PGLITE_PORT=5434 PGLITE_DATA_DIR=.pglite-test-data tsx scripts/dev-db.ts",
    "test:migrate": "cross-env DATABASE_URL=\"postgresql://postgres:postgres@127.0.0.1:5434/postgres?schema=public&sslmode=disable&pgbouncer=true&connection_limit=1\" tsx scripts/apply-migrations-pglite.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.20.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "otpauth": "^9.3.4",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "pg": "^8.23.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
